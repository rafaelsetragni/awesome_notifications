    "version": "0.2.0",
    "configurations": [
        {
            "name": "Complete Example",
            "cwd": "examples/complete_example",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart"
        },
        {
            "name": "Complete Example (profile mode)",
            "cwd": "examples/complete_example",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "program": "lib/main.dart"
        },
        {
            "name": "Complete Example (release mode)",
            "cwd": "examples/complete_example",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "program": "lib/main.dart"
        },
        {
            "name": "Example (Base)",
            "cwd": "packages/awesome_notifications/example",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart"
        },
        {
            "name": "Example (Localizations)",
            "cwd": "packages/awesome_notifications_localizations/example",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart"
        },
        {
            "name": "Example (Schedules)",
            "cwd": "packages/awesome_notifications_schedules/example",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart"
        },
        {
            "name": "Tests + coverage (Core)",
            "cwd": "packages/awesome_notifications",
            "request": "launch",
            "type": "dart",
            "program": "test/",
            "toolArgs": [
                "--coverage"
            ]
        },
        {
            "name": "Tests + coverage (Schedules)",
            "cwd": "packages/awesome_notifications_schedules",
            "request": "launch",
            "type": "dart",
            "program": "test/",
            "toolArgs": [
                "--coverage"
            ]
        },
        {
            "name": "Tests + coverage (Localizations)",
            "cwd": "packages/awesome_notifications_localizations",
            "request": "launch",
            "type": "dart",
            "program": "test/",
            "toolArgs": [
                "--coverage"
            ]
        }
    ],
    "compounds": [
        {
            "name": "Tests + coverage (All packages)",
            "configurations": [
                "Tests + coverage (Core)",
                "Tests + coverage (Schedules)",
                "Tests + coverage (Localizations)"
            ],
            "stopAll": true
        }
    ]
}
