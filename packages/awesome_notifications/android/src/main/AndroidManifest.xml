<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="me.carda.awesome_notifications">

  <!-- Required to post notifications on Android 13 (API 33) and above. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <!-- Receives the notification deleteIntent (swipe-away) to emit the
         "notificationDismissed" event. -->
    <receiver
      android:name="me.carda.android_awn_core.DismissedNotificationReceiver"
      android:exported="false" />
  </application>
</manifest>
